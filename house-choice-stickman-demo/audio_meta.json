{
  "bgm": null,
  "bgm_pending": false,
  "voices": [
    {
      "frame": 1,
      "path": ".media/audio/voice/scenes/01.wav",
      "duration_s": 32.595542,
      "words": [
        {
          "id": "w0",
          "text": "你有没有过这样的感觉，",
          "start": 0,
          "end": 1.452
        },
        {
          "id": "w1",
          "text": "自己陷入那种好像什么都有一点可能，",
          "start": 1.923,
          "end": 4.306
        },
        {
          "id": "w2",
          "text": "但又什么都做不到的恐惧里。",
          "start": 4.765,
          "end": 6.434
        },
        {
          "id": "w3",
          "text": "你突然觉得自己很弱小，",
          "start": 6.854,
          "end": 8.397
        },
        {
          "id": "w4",
          "text": "好像已经经不起任何一次失败。",
          "start": 8.867,
          "end": 10.76
        },
        {
          "id": "w5",
          "text": "想换工作，",
          "start": 11.202,
          "end": 11.975
        },
        {
          "id": "w6",
          "text": "又怕找不到更好的。",
          "start": 12.416,
          "end": 13.615
        },
        {
          "id": "w7",
          "text": "想去大城市，",
          "start": 14.072,
          "end": 14.899
        },
        {
          "id": "w8",
          "text": "又怕一个人在那里撑不下来。",
          "start": 15.292,
          "end": 17.002
        },
        {
          "id": "w9",
          "text": "想考研，",
          "start": 17.427,
          "end": 18.042
        },
        {
          "id": "w10",
          "text": "又怕辛辛苦苦准备一年，",
          "start": 18.495,
          "end": 20.024
        },
        {
          "id": "w11",
          "text": "最后还是失败。",
          "start": 20.442,
          "end": 21.418
        },
        {
          "id": "w12",
          "text": "甚至想过，",
          "start": 21.816,
          "end": 22.564
        },
        {
          "id": "w13",
          "text": "要不就找个人结婚，",
          "start": 22.991,
          "end": 24.2
        },
        {
          "id": "w14",
          "text": "安安稳稳过日子算了。",
          "start": 24.613,
          "end": 25.993
        },
        {
          "id": "w15",
          "text": "可你又不甘心。",
          "start": 26.414,
          "end": 27.319
        },
        {
          "id": "w16",
          "text": "你害怕几年以后回过头来，",
          "start": 27.744,
          "end": 29.396
        },
        {
          "id": "w17",
          "text": "发现这一辈子，",
          "start": 29.91,
          "end": 30.844
        },
        {
          "id": "w18",
          "text": "就这样过去了。",
          "start": 31.333,
          "end": 32.219
        }
      ]
    },
    {
      "frame": 2,
      "path": ".media/audio/voice/scenes/02.wav",
      "duration_s": 18.013375,
      "words": [
        {
          "id": "w0",
          "text": "于是很奇怪的一件事发生了。",
          "start": 0,
          "end": 1.825
        },
        {
          "id": "w1",
          "text": "你明明有很多选择，",
          "start": 2.403,
          "end": 3.604
        },
        {
          "id": "w2",
          "text": "最后却什么都没有选。",
          "start": 3.969,
          "end": 5.165
        },
        {
          "id": "w3",
          "text": "你越来越害怕失败，",
          "start": 5.914,
          "end": 7.072
        },
        {
          "id": "w4",
          "text": "越来越觉得自己经不起任何一次失误。",
          "start": 7.555,
          "end": 9.85
        },
        {
          "id": "w5",
          "text": "世界那么大，",
          "start": 10.77,
          "end": 11.562
        },
        {
          "id": "w6",
          "text": "你却觉得自己哪里也去不了。",
          "start": 11.923,
          "end": 13.559
        },
        {
          "id": "w7",
          "text": "就好像，",
          "start": 14.129,
          "end": 14.639
        },
        {
          "id": "w8",
          "text": "有一堵看不见的墙，",
          "start": 15.094,
          "end": 16.3
        },
        {
          "id": "w9",
          "text": "把你困在了原地。",
          "start": 16.582,
          "end": 17.637
        }
      ]
    },
    {
      "frame": 3,
      "path": ".media/audio/voice/scenes/03.wav",
      "duration_s": 32.648729,
      "words": [
        {
          "id": "w0",
          "text": "可后来你会发现，",
          "start": 0,
          "end": 1.149
        },
        {
          "id": "w1",
          "text": "真正困住你的，",
          "start": 1.584,
          "end": 2.586
        },
        {
          "id": "w2",
          "text": "可能从来都不是工作，",
          "start": 3.007,
          "end": 4.432
        },
        {
          "id": "w3",
          "text": "不是城市，",
          "start": 4.896,
          "end": 5.463
        },
        {
          "id": "w4",
          "text": "不是考研，",
          "start": 5.87,
          "end": 6.507
        },
        {
          "id": "w5",
          "text": "也不是婚姻。",
          "start": 6.961,
          "end": 7.729
        },
        {
          "id": "w6",
          "text": "而是你总想找到一条，",
          "start": 8.172,
          "end": 9.552
        },
        {
          "id": "w7",
          "text": "“不会失败的路”。",
          "start": 10.025,
          "end": 10.91
        },
        {
          "id": "w8",
          "text": "换工作之前，",
          "start": 11.333,
          "end": 12.171
        },
        {
          "id": "w9",
          "text": "你想先确定下一份工作一定更好。",
          "start": 12.586,
          "end": 14.781
        },
        {
          "id": "w10",
          "text": "去大城市之前，",
          "start": 15.196,
          "end": 16.194
        },
        {
          "id": "w11",
          "text": "你想先确定自己一定能留下来。",
          "start": 16.615,
          "end": 18.594
        },
        {
          "id": "w12",
          "text": "考研之前，",
          "start": 19.036,
          "end": 19.733
        },
        {
          "id": "w13",
          "text": "你想先知道自己一定能考上。",
          "start": 20.137,
          "end": 21.945
        },
        {
          "id": "w14",
          "text": "甚至面对爱情，",
          "start": 22.303,
          "end": 23.33
        },
        {
          "id": "w15",
          "text": "你也希望先确定，",
          "start": 23.758,
          "end": 24.866
        },
        {
          "id": "w16",
          "text": "这个人绝不会影响你未来的人生。",
          "start": 25.339,
          "end": 27.313
        },
        {
          "id": "w17",
          "text": "你不是没有选择。",
          "start": 27.675,
          "end": 28.775
        },
        {
          "id": "w18",
          "text": "你只是希望，",
          "start": 29.205,
          "end": 30.019
        },
        {
          "id": "w19",
          "text": "每一个选择都先给你一个保证。",
          "start": 30.448,
          "end": 32.285
        }
      ]
    },
    {
      "frame": 4,
      "path": ".media/audio/voice/scenes/04.wav",
      "duration_s": 46.955292,
      "words": [
        {
          "id": "w0",
          "text": "可人生最残酷，",
          "start": 0,
          "end": 1.119
        },
        {
          "id": "w1",
          "text": "也最真实的地方就在这里：",
          "start": 1.578,
          "end": 3.326
        },
        {
          "id": "w2",
          "text": "它从来不会先告诉你答案。",
          "start": 3.786,
          "end": 5.424
        },
        {
          "id": "w3",
          "text": "很多时候，",
          "start": 5.859,
          "end": 6.516
        },
        {
          "id": "w4",
          "text": "我们以为自己是在追求安全感。",
          "start": 6.945,
          "end": 8.837
        },
        {
          "id": "w5",
          "text": "其实是在用“我不能失败”，",
          "start": 9.278,
          "end": 10.803
        },
        {
          "id": "w6",
          "text": "一点一点缩小自己的人生。",
          "start": 11.285,
          "end": 12.87
        },
        {
          "id": "w7",
          "text": "怕失业，",
          "start": 13.272,
          "end": 13.83
        },
        {
          "id": "w8",
          "text": "于是你不敢换工作。",
          "start": 14.257,
          "end": 15.485
        },
        {
          "id": "w9",
          "text": "怕失败，",
          "start": 15.937,
          "end": 16.481
        },
        {
          "id": "w10",
          "text": "于是你不敢开始。",
          "start": 16.894,
          "end": 17.989
        },
        {
          "id": "w11",
          "text": "怕选错，",
          "start": 18.441,
          "end": 19.009
        },
        {
          "id": "w12",
          "text": "于是干脆什么都不选。",
          "start": 19.416,
          "end": 20.76
        },
        {
          "id": "w13",
          "text": "最后你避开了很多风险，",
          "start": 21.219,
          "end": 22.702
        },
        {
          "id": "w14",
          "text": "也一起避开了那些，",
          "start": 23.169,
          "end": 24.425
        },
        {
          "id": "w15",
          "text": "本来可能发生的人生。",
          "start": 24.862,
          "end": 26.125
        },
        {
          "id": "w16",
          "text": "所以真正的问题，",
          "start": 26.48,
          "end": 27.572
        },
        {
          "id": "w17",
          "text": "从来不是：",
          "start": 28.036,
          "end": 28.658
        },
        {
          "id": "w18",
          "text": "“哪条路最安全？”",
          "start": 29.07,
          "end": 30.107
        },
        {
          "id": "w19",
          "text": "而是：",
          "start": 30.535,
          "end": 30.909
        },
        {
          "id": "w20",
          "text": "“如果没有任何一条路能保证成功，",
          "start": 31.396,
          "end": 33.371
        },
        {
          "id": "w21",
          "text": "你还愿不愿意，",
          "start": 33.932,
          "end": 34.772
        },
        {
          "id": "w22",
          "text": "为自己真正想要的人生，",
          "start": 35.104,
          "end": 36.564
        },
        {
          "id": "w23",
          "text": "承担一次失败的可能？”",
          "start": 36.885,
          "end": 38.224
        },
        {
          "id": "w24",
          "text": "真正的安全感，",
          "start": 38.671,
          "end": 39.611
        },
        {
          "id": "w25",
          "text": "从来不是",
          "start": 40.072,
          "end": 40.694
        },
        {
          "id": "w26",
          "text": "“我永远不会失败”。",
          "start": 41.126,
          "end": 42.164
        },
        {
          "id": "w27",
          "text": "而是：",
          "start": 42.581,
          "end": 42.978
        },
        {
          "id": "w28",
          "text": "即使失败了，",
          "start": 43.318,
          "end": 44.064
        },
        {
          "id": "w29",
          "text": "我也相信自己有重新来过的能力。",
          "start": 44.48,
          "end": 46.579
        }
      ]
    }
  ],
  "sfx": [],
  "total_duration_s": 130.212938
}
