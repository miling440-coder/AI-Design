{
  "bgm": null,
  "bgm_pending": false,
  "voices": [
    {
      "frame": 1,
      "path": ".media/audio/voice/scenes/01.wav",
      "duration_s": 19,
      "words": [
        {
          "id": "f1p1",
          "text": "你有没有发现",
          "start": 0.18,
          "end": 1.357
        },
        {
          "id": "f1p2",
          "text": "很多年轻人不是买不起房",
          "start": 1.577,
          "end": 3.736
        },
        {
          "id": "f1p3",
          "text": "而是——不敢不买房",
          "start": 3.956,
          "end": 5.722
        },
        {
          "id": "f1p4",
          "text": "二十七八岁",
          "start": 5.942,
          "end": 6.923
        },
        {
          "id": "f1p5",
          "text": "工作四五年",
          "start": 7.143,
          "end": 8.124
        },
        {
          "id": "f1p6",
          "text": "自己攒了二三十万",
          "start": 8.344,
          "end": 9.914
        },
        {
          "id": "f1p7",
          "text": "父母再拿出一点积蓄",
          "start": 10.134,
          "end": 11.9
        },
        {
          "id": "f1p8",
          "text": "差不多就够一套房子的首付了",
          "start": 12.12,
          "end": 14.672
        },
        {
          "id": "f1p9",
          "text": "然后你会发现",
          "start": 14.892,
          "end": 16.069
        },
        {
          "id": "f1p10",
          "text": "周围几乎所有人都开始告诉你",
          "start": 16.289,
          "end": 18.84
        }
      ]
    },
    {
      "frame": 2,
      "path": ".media/audio/voice/scenes/02.wav",
      "duration_s": 20,
      "words": [
        {
          "id": "f2p1",
          "text": "早点买",
          "start": 0.18,
          "end": 0.887
        },
        {
          "id": "f2p2",
          "text": "房子迟早都要有",
          "start": 1.107,
          "end": 2.757
        },
        {
          "id": "f2p3",
          "text": "没房以后怎么结婚",
          "start": 2.977,
          "end": 4.863
        },
        {
          "id": "f2p4",
          "text": "等以后涨了你就更买不起了",
          "start": 5.083,
          "end": 7.912
        },
        {
          "id": "f2p5",
          "text": "最可怕的是什么",
          "start": 8.132,
          "end": 9.782
        },
        {
          "id": "f2p6",
          "text": "是听久了以后",
          "start": 10.002,
          "end": 11.417
        },
        {
          "id": "f2p7",
          "text": "你自己也开始慌",
          "start": 11.637,
          "end": 13.287
        },
        {
          "id": "f2p8",
          "text": "这套房子适不适合现在的我",
          "start": 13.507,
          "end": 16.335
        },
        {
          "id": "f2p9",
          "text": "如果我不买",
          "start": 16.555,
          "end": 17.734
        },
        {
          "id": "f2p10",
          "text": "我是不是就落后了",
          "start": 17.954,
          "end": 19.84
        }
      ]
    },
    {
      "frame": 3,
      "path": ".media/audio/voice/scenes/03.wav",
      "duration_s": 20,
      "words": [
        {
          "id": "f3p1",
          "text": "很多年前",
          "start": 0.18,
          "end": 0.801
        },
        {
          "id": "f3p2",
          "text": "也有一个年轻人面临类似的选择",
          "start": 1.021,
          "end": 3.196
        },
        {
          "id": "f3p3",
          "text": "他工作没几年",
          "start": 3.416,
          "end": 4.348
        },
        {
          "id": "f3p4",
          "text": "手里刚刚攒下人生第一笔钱",
          "start": 4.568,
          "end": 6.431
        },
        {
          "id": "f3p5",
          "text": "这笔钱可以拿去买一套房",
          "start": 6.651,
          "end": 8.36
        },
        {
          "id": "f3p6",
          "text": "但是如果买了",
          "start": 8.58,
          "end": 9.512
        },
        {
          "id": "f3p7",
          "text": "自己手里的资本基本也就没有了",
          "start": 9.732,
          "end": 11.906
        },
        {
          "id": "f3p8",
          "text": "还有另外一个选择",
          "start": 12.126,
          "end": 13.369
        },
        {
          "id": "f3p9",
          "text": "把钱留下来",
          "start": 13.589,
          "end": 14.365
        },
        {
          "id": "f3p10",
          "text": "继续做自己真正擅长的事情",
          "start": 14.585,
          "end": 16.449
        },
        {
          "id": "f3p11",
          "text": "妻子选择了后者",
          "start": 16.669,
          "end": 17.756
        },
        {
          "id": "f3p12",
          "text": "这个年轻人叫沃伦·巴菲特",
          "start": 17.976,
          "end": 19.84
        }
      ]
    },
    {
      "frame": 4,
      "path": ".media/audio/voice/scenes/04.wav",
      "duration_s": 19,
      "words": [
        {
          "id": "f4p1",
          "text": "但我讲这个故事",
          "start": 0.18,
          "end": 1.148
        },
        {
          "id": "f4p2",
          "text": "不是想告诉你年轻人千万不要买房",
          "start": 1.368,
          "end": 3.443
        },
        {
          "id": "f4p3",
          "text": "完全不是",
          "start": 3.663,
          "end": 4.216
        },
        {
          "id": "f4p4",
          "text": "有些人需要稳定的住所",
          "start": 4.436,
          "end": 5.819
        },
        {
          "id": "f4p5",
          "text": "有人有孩子有老人",
          "start": 6.039,
          "end": 7.146
        },
        {
          "id": "f4p6",
          "text": "有人就是喜欢拥有一个真正属于自己的家",
          "start": 7.366,
          "end": 9.856
        },
        {
          "id": "f4p7",
          "text": "房子当然有它的价值",
          "start": 10.076,
          "end": 11.321
        },
        {
          "id": "f4p8",
          "text": "真正值得想的是另外一个问题",
          "start": 11.541,
          "end": 13.339
        },
        {
          "id": "f4p9",
          "text": "当你人生第一次拥有二三十万的时候",
          "start": 13.559,
          "end": 15.772
        },
        {
          "id": "f4p10",
          "text": "这笔钱对现在的你来说",
          "start": 15.992,
          "end": 17.375
        },
        {
          "id": "f4p11",
          "text": "最重要的价值是什么",
          "start": 17.595,
          "end": 18.84
        }
      ]
    },
    {
      "frame": 5,
      "path": ".media/audio/voice/scenes/05.wav",
      "duration_s": 22,
      "words": [
        {
          "id": "f5p1",
          "text": "是一套房",
          "start": 0.18,
          "end": 0.964
        },
        {
          "id": "f5p2",
          "text": "是一门技能",
          "start": 1.184,
          "end": 2.165
        },
        {
          "id": "f5p3",
          "text": "一次创业机会",
          "start": 2.385,
          "end": 3.561
        },
        {
          "id": "f5p4",
          "text": "换一座城市",
          "start": 3.781,
          "end": 4.762
        },
        {
          "id": "f5p5",
          "text": "还是给自己几年时间",
          "start": 4.982,
          "end": 6.746
        },
        {
          "id": "f5p6",
          "text": "去成为一个更有选择权的人",
          "start": 6.966,
          "end": 9.319
        },
        {
          "id": "f5p7",
          "text": "很多时候",
          "start": 9.539,
          "end": 10.324
        },
        {
          "id": "f5p8",
          "text": "我们花光积蓄购买的",
          "start": 10.544,
          "end": 12.308
        },
        {
          "id": "f5p9",
          "text": "可能不仅仅是一套房子",
          "start": 12.528,
          "end": 14.489
        },
        {
          "id": "f5p10",
          "text": "还有一种感觉",
          "start": 14.709,
          "end": 15.886
        },
        {
          "id": "f5p11",
          "text": "我终于和别人一样了",
          "start": 16.106,
          "end": 17.871
        },
        {
          "id": "f5p12",
          "text": "可人生真正危险的",
          "start": 18.091,
          "end": 19.659
        },
        {
          "id": "f5p13",
          "text": "从来不是和别人不一样",
          "start": 19.879,
          "end": 21.84
        }
      ]
    },
    {
      "frame": 6,
      "path": ".media/audio/voice/scenes/06.wav",
      "duration_s": 18.944,
      "words": [
        {
          "id": "f6p1",
          "text": "而是有一天你突然发现",
          "start": 0.18,
          "end": 1.837
        },
        {
          "id": "f6p2",
          "text": "你拼命做出的那些选择",
          "start": 2.057,
          "end": 3.714
        },
        {
          "id": "f6p3",
          "text": "其实从来没有真正问过自己",
          "start": 3.934,
          "end": 5.922
        },
        {
          "id": "f6p4",
          "text": "所以买房没有错",
          "start": 6.142,
          "end": 7.302
        },
        {
          "id": "f6p5",
          "text": "不买也没有错",
          "start": 7.522,
          "end": 8.516
        },
        {
          "id": "f6p6",
          "text": "真正值得害怕的是",
          "start": 8.736,
          "end": 10.062
        },
        {
          "id": "f6p7",
          "text": "你根本不知道自己为什么要买",
          "start": 10.282,
          "end": 12.436
        },
        {
          "id": "f6p8",
          "text": "如果现在给你30万",
          "start": 12.656,
          "end": 14.147
        },
        {
          "id": "f6p9",
          "text": "一边是房子的首付",
          "start": 14.367,
          "end": 15.693
        },
        {
          "id": "f6p10",
          "text": "一边是未来五年的可能性",
          "start": 15.913,
          "end": 17.736
        },
        {
          "id": "f6p11",
          "text": "你会怎么选",
          "start": 17.956,
          "end": 18.784
        }
      ]
    }
  ],
  "sfx": []
}
