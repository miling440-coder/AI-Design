},
{
"t0": 20.7,
"t1": 27.1,
"kind": "words",
"text": "07:30  闹钟 / 地铁 / 工位 / 绩效 / 外卖 / 加班 / 刷手机 / 凌晨两点",
"fx": []
},
{
"t0": 27.1,
"t1": 30.2,
"kind": "block",
"text": "日 复 一 日。",
